xkb_keymap {
	xkb_keycodes  { include "evdev+aliases(qwerty)"	};
	xkb_types     { include "complete"	};
	xkb_compat    { include "complete"	};
	xkb_geometry  { include "pc(pc105)"	};

    xkb_symbols "my" {
        include "pc+us+ru:2+inet(evdev)+terminate(ctrl_alt_bksp)+group(win_space_toggle):1+group(win_space_toggle):2"

        key <MENU> { [ Super_L ] };
    };
};
